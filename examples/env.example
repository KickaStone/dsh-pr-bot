# Credentials for dsh-pr-bot. Keep this file at mode 0600 and out of git.
#
# Recommended: a GitHub App gives the bot its own reviewer identity, so it can
# submit REQUEST_CHANGES / APPROVE on pull requests you authored.
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/home/you/.config/dsh-pr-bot/app.pem

# Fallback: a separate reviewer account's token.
# GITHUB_BOT_TOKEN=github_pat_...

# Fallback: your own token. Comment-only on pull requests you authored.
# GITHUB_TOKEN=github_pat_...
